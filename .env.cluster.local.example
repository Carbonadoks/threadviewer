# Copy this file to .env.cluster.local before running:
#   npm run embeddb:build -- <handle>
#
# Required for embeddb:build:
# - CLOUDFLARE_ACCOUNT_ID or CLUSTER_R2_ACCOUNT_ID
# - CLOUDFLARE_API_TOKEN or CF_API_TOKEN
#
# Only the two values below are required for the local SQLite embedding builder.
# The commented values farther down are only needed by other scripts in this repo.

CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# Optional alias names supported by embeddb:build:
# CLUSTER_R2_ACCOUNT_ID=your_cloudflare_account_id
# CF_API_TOKEN=your_cloudflare_api_token

# Optional shared config for other local scripts in this repo:
# CLUSTER_R2_ACCESS_KEY_ID=your_r2_access_key_id
# CLUSTER_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# CLUSTER_R2_BUCKET=thread-viewer-cache
# FETCH=1
# GEMINI_API_KEY=your_gemini_api_key
